  "the_archive_cannot_fix_this": {
    "claim": "banking more pale-background fixtures would let a precondition be calibrated",
    "verdict": "FALSE - measured",
    "census": "The 31 files categorised pale-background in M:/claud_projects/bookscan_captures are 11 frames of page_001 (a lap shot), 18 frames of page_002 (the sofa shot) and 2 more frames of the lap scene from a patch-mode run. TWO scenes, one session, one book, one surface each - not 31 examples.",
    "consequence": "Question 1 has exactly ONE usable positive (paleset_02); paleset_01's scene is a negative for A10 itself. Calibrating a precondition needs NEW photographs of NEW surfaces, not more frames out of the archive.",
    "corrects": "the impression left by the capture-archive note that 31 pale captures exist"
  },
