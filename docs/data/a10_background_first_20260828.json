  "question_1_is_NOT_solved": {
    "question": "Is there a background at all? (paleset_02 vs the 13 flat rows)",
    "families_measured": 8,
    "results": {
      "1_paper_mask_statistics_six_of_them": "closed in Phase 1, see phase1_honest_failure_20260828.json",
      "2_mahalanobis_scalars": {
        "ring_p90": "structurally useless - Mahalanobis of the ring under the ring's OWN model, self-normalising, 2.14-3.11 across all 21",
        "ring_frac_far": "paleset_02 0.025 inside flat range 0.011-0.050",
        "inner_med": "paleset 2.17/2.73 inside flat range 1.74-7.37",
        "inner_frac_far": "paleset 0.317/0.476 inside flat range 0.123-0.857"
      },
      "3_absolute_ring_homogeneity_lab_std": {
