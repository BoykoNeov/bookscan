        "nearest_negative_it_geo_06": 19.81,
        "range": "19.52-68.66",
        "gap": 0.29,
        "verdict": "a 0.29 gap on a 50-unit scale is noise, not a gate"
      },
      "4_blob_compactness": {
        "paleset_02": 0.91,
        "bg_01": 0.87,
        "connectivity_variant": "bg_01 0.94 ABOVE paleset_02 0.92 - inverted",
        "rectangularity": "paleset_02 0.92 vs bg_01 0.87 - same failure"
      },
      "5_connectivity": {
        "ring_coverage": "paleset_02 0.995 inside 0.849-1.000",
        "enclosure": "degenerate: 1.000 for all 21 by construction"
      },
      "6_text_ink_veto": {
        "verdict": "fabric texture reads as glyphs",
        "paleset_02": "63.75% of text-like ink outside a box that clips 0.00%"
      },
      "7_brightness_polarity": {
        "idea": "a book is brighter than what it lies on; a print area is darker than the paper around it",
        "paleset_02_dL": 72.0,
        "bg_01_dL": 71.0,
        "bg_02_dL": 71.0,
        "bg_03_dL": 69.0,
        "verdict": "no separation - the darker margin or shadow of a flat scan gives the same sign and the same size"
      },
      "8_border_texture": {
        "idea": "a woven sofa has high-frequency structure, a paper margin does not",
        "paleset_02_sobel_med": 69.87,
        "bg_01": 71.34,
        "it_geo_04": 69.81,
        "paleset_01": 11.05,
        "verdict": "the weave is indistinguishable from page texture. The plan's own A3/A6 predicted this (upholstery is smooth at both scales); it is now measured rather than predicted."
      }
    },
    "why_structurally": "On a tightly framed scan the border IS the page, so a background-first method finds the printed area instead of the book - and a printed area is also large, also rectangular, also compact, also darker-bordered, and at the ring also textured. Every property that makes a book look like a book is shared by the thing this method finds when it inverts."
  },
